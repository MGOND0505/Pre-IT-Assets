# Used only by `docker compose` (root-level, separate from backend/.env and frontend/.env.local).
# Not used for native local dev - see backend/.env.example and frontend/.env.local.example instead.

JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_COOKIE_NAME=itam_token
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3001
MAIL_PROVIDER=console
SUPERADMIN_SEED_NAME=Super Admin
SUPERADMIN_SEED_EMAIL=admin@example.local
SUPERADMIN_SEED_PASSWORD=

NEXT_PUBLIC_API_BASE_URL=http://localhost:5001/api
NEXT_PUBLIC_APP_NAME=IT Asset & License Management
