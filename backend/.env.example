NODE_ENV=development
PORT=5001

MONGODB_URI=mongodb://127.0.0.1:27017/it_asset_management

JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_COOKIE_NAME=itam_token
COOKIE_SECURE=false

FRONTEND_URL=http://localhost:3001

BCRYPT_SALT_ROUNDS=10
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_DURATION_MINUTES=15

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=2000

LOG_LEVEL=info

MAIL_PROVIDER=console

SUPERADMIN_SEED_NAME=Admin
SUPERADMIN_SEED_EMAIL=admin@example.local
SUPERADMIN_SEED_PASSWORD=

# Optional - only needed if the Metabase analytics embed (see metabase/README.md) is set up.
METABASE_URL=
METABASE_EMBEDDING_SECRET_KEY=
METABASE_DASHBOARD_ID=

# Optional - one global Cloudflare Turnstile key pair for the whole deployment. Required before
# any organization's "CAPTCHA enable" toggle (Settings > Password Policy) can be turned on.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
